# The Caravan API. Leave unset to run entirely offline on the localStorage data
# layer — which is how the whole frontend was built, and what the demo convoy
# needs. Anything that is not an absolute http(s) URL is treated as unset.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Web Push. Must match VAPID_PUBLIC_KEY on the API.
# Leave unset to keep alerts tab-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google sign-in. The OAuth *client id* only — no secret is involved. Must
# match GOOGLE_CLIENT_ID on the API, or every token is rejected on the
# audience check. Leave unset and the app runs exactly as it did before
# accounts existed: sign-in is not offered and Google's script is never loaded.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
